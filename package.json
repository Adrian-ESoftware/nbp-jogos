{
  "name": "nbp-jogos",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "vite build",
    "build": "npm run validate:catalog && npm run validate:datasets && vite build",
    "build:cloudflare": "NITRO_PRESET=node-server VITE_BASE_PATH=/ npm run build && VITE_BASE_PATH=/ node scripts/export-static.mjs",
    "deploy:cloudflare": "npm run build:cloudflare && npx wrangler pages deploy .output/public --project-name nbp-jogos --branch main",
    "build:datasets": "node scripts/build-datasets.mjs",
    "validate:catalog": "node scripts/validate-catalog.mjs",
    "validate:datasets": "node scripts/validate-datasets.mjs",
    "test:catalog": "node --test tests/catalog.test.mjs",
    "test:datasets": "node --test tests/datasets.test.mjs",
    "test:golpe": "node --test tests/golpe.test.mjs",
    "test": "npm run test:catalog && npm run test:datasets && npm run test:golpe",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.14",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-query-devtools": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.3",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.5",
    "@tanstack/react-store": "0.11.2",
    "@tanstack/store": "0.11.2",
    "lucide": "^1.72.0",
    "lucide-react": "^1.72.0",
    "motion": "^14.12.0",
    "nitro": "3.0.260610-beta",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-event-client": "0.5.1",
    "@tanstack/devtools-vite": "0.8.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
